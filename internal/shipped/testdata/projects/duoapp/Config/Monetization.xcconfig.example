// Template for the real Config/Monetization.xcconfig, which is written by the
// release workflow from [[product]].secrets and never committed. The managed
// .gitignore region renders `**/Config/Monetization.xcconfig` because this
// project redirects its release keys away from the default Secrets.xcconfig.
//
// A URL value must use the /$()/ escape: xcconfig treats `//` as a comment, so
// an unescaped one truncates to a non-empty value that works for nothing.
REVENUECAT_API_KEY = appl_xxxxxxxxxxxxxxxxxxxxxxxx
ADMOB_APP_ID = ca-app-pub-0000000000000000~0000000000
