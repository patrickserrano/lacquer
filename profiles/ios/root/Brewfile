# Brewfile for iOS project dependencies
# Run: brew bundle install

# iOS Development
# xcodegen: the profile's project.yml -> .pbxproj generator. Every project on
# this profile regenerates rather than hand-editing the pbxproj, so the tool is
# not optional — it was simply missing from this list.
# actionlint: lints the synced workflows before they reach CI, which is how the
# release-workflow changes in this profile get checked at all.
brew "xcodegen"
brew "actionlint"
brew "swiftlint"
# swiftformat is deliberately NOT here. Homebrew has no versioned formula, so a
# `brew upgrade` changed its default rules under every project at once. CI, the
# hooks, `lacquer fix` and `lacquer doctor` run the release pinned by
# swiftformat_version through scripts/swiftformat-pinned.sh instead.
cask "periphery"

# Release / signing — Codemagic CLI tools (app-store-connect, xcode-project),
# installed via pipx. `xcode-project use-profiles` needs the Ruby `xcodeproj`
# gem, hence ruby@3.2.
brew "pipx"
brew "ruby@3.2"

# Git hooks
brew "pre-commit"
