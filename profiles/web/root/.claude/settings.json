{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/scripts/stale-checkout-warning.sh\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'command -v lacquer >/dev/null 2>&1 || exit 0; lacquer console inbox hook stop || true'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
